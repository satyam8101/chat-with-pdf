# Google AI Studio (free tier) - required for embeddings
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the dimension the Chroma collection was created with (3072 here)
GEMINI_EMBED_DIMENSIONS=3072

# Optional embedding fallbacks (only if Gemini fails)
JINA_API_KEY=
HF_TOKEN=

# Groq (free tier) - required for RAG answers
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# Chroma Cloud (hosted vector store) - required
CHROMA_API_KEY=your_chroma_cloud_key
CHROMA_TENANT=your_tenant_id
CHROMA_DATABASE=your_database_name
CHROMA_COLLECTION=resumes

# Input
RESUMES_DIR=resumes
TOP_K=4